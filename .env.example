# Copy to .env.local and fill in locally. Never commit real values.
# Deadline / automation secrets are set with `npx convex env set`, not here.
# See .docs/08-local-setup-runbook.md for the full setup order.

# Convex deployment URL (from `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=

# Clerk dev instance (Dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
