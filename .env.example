# Copy to .env.local and fill in locally. Never commit real values.
# Convex-side secrets are set with `npx convex env set`, never in this file.
# See .docs/08-local-setup-runbook.md for the full setup order.

# Convex deployment URL (from `npm run dev:convex`)
NEXT_PUBLIC_CONVEX_URL=

# Clerk dev instance (Dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# NOTE: CLERK_JWT_ISSUER_DOMAIN (Clerk Frontend API URL) belongs on the Convex
# deployment, not in .env.local:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://verb-noun-00.clerk.accounts.dev
